{
  "name": "exhibition-screens-frontend",
  "version": "0.1.0",
  "private": true,
  "author": {
    "name": "Pyry Mäkinen",
    "email": "pyry.makinen@helsinki.fi"
  },
  "homepage": "https://github.com/luomus/exhibition-screens",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "npm --prefix ../shared run build && npm run dev:app",
    "dev:app": "electron-vite dev --watch",
    "build": "npm run typecheck && electron-vite build",
    "package:dev": "npm run build && electron-builder build",
    "package:prod": "npm run build && electron-builder build --linux deb --arm64",
    "start": "electron-vite preview --skipBuild",
    "typecheck": "npm --prefix ../shared run build && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json"
  },
  "dependencies": {
    "@exhibition-screens/shared": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "electron": "44.7.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.7"
  }
}
